# TFocus AI local configuration
NODE_ENV=development
TFOCUS_API_HOST=127.0.0.1
TFOCUS_API_PORT=4100
TFOCUS_TIMEZONE=Asia/Ho_Chi_Minh
TFOCUS_MODE=ASSIST
TFOCUS_DATA_DIR=./data
TFOCUS_TOOLS_URL=http://127.0.0.1:4000
TFOCUS_DATABASE_URL=postgresql://chatbotx:secretkey@127.0.0.1:5432/chatbotx
TFOCUS_REDIS_URL=redis://127.0.0.1:6379
TFOCUS_SERVICE_TOKEN=local-tfocus-service-token-change-me
TFOCUS_REQUIRE_AUTH=false
# Google Calendar is intentionally disabled until OAuth credentials are configured.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
